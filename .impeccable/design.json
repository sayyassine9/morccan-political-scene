  "components": [
    {
      "name": "Comparison Row",
      "kind": "custom",
      "refersTo": "comparison-cell",
      "description": "The system's core unit: a trough label cell and one cell per party, all on one shared grid.",
      "html": "<div class=\"ds-cmp\"><div class=\"ds-row\"><div class=\"ds-label\">Social protection</div><div class=\"ds-cell\"><div class=\"ds-fig\"><bdi>−1</bdi></div><span class=\"ds-meter\"><span class=\"ds-track\"></span><span class=\"ds-axis\"></span><span class=\"ds-bar\" style=\"inset-inline-end:50%;width:25%;--c:var(--s1,#2a6fb0)\"></span></span><div class=\"ds-scale\"><span>Targeted benefits</span><span>Universal entitlements</span></div><div class=\"ds-sub\">Proposes inflation protection for existing eligible social-aid households.</div><span class=\"ds-ev ds-ev-single\">single source</span></div><div class=\"ds-cell\"><div class=\"ds-fig\"><bdi>−1</bdi></div><span class=\"ds-meter\"><span class=\"ds-track\"></span><span class=\"ds-axis\"></span><span class=\"ds-bar\" style=\"inset-inline-end:50%;width:25%;--c:var(--s2,#c5541f)\"></span></span><div class=\"ds-scale\"><span>Targeted benefits</span><span>Universal entitlements</span></div><div class=\"ds-sub\">Proposes higher direct aid with eligibility based on actual household income.</div><span class=\"ds-ev ds-ev-single\">single source</span></div></div></div>",
      "css": ".ds-cmp{border-block-start:2px solid var(--ink,#15181c);font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-row{display:grid;grid-template-columns:minmax(118px,.78fr) repeat(2,minmax(0,1fr));border-block-end:1px solid var(--rule,#d8d3c4)}.ds-row:hover{background:color-mix(in oklab,var(--signal,#e8a13a) 7%,transparent)}.ds-label{padding:12px 14px;font-weight:700;font-size:14.5px;align-self:center;background:var(--sunken,#e7e3d6);border-inline-end:1px solid var(--rule,#d8d3c4);color:var(--ink,#15181c)}.ds-cell{padding:12px 14px;border-inline-start:1px solid var(--rule,#d8d3c4);min-width:0;color:var(--ink,#15181c)}.ds-cell:first-of-type{border-inline-start:none}.ds-fig{font-weight:800;font-size:19px;font-variant-numeric:tabular-nums;letter-spacing:-.02em}.ds-meter{display:block;height:22px;position:relative;margin-block-start:6px}.ds-track{position:absolute;inset-block:9px;inset-inline:0;background:var(--sunken,#e7e3d6);border-radius:999px}.ds-axis{position:absolute;inset-block:3px;inset-inline-start:50%;width:1px;background:var(--rule-strong,#b9b3a1)}.ds-bar{position:absolute;inset-block:6px;border-radius:3px;background:var(--c)}.ds-scale{display:flex;justify-content:space-between;font-size:11px;color:var(--muted,#61646a);margin-block-start:2px;gap:8px}.ds-sub{font-size:13px;color:var(--ink-2,#4a4f56);margin-block-start:2px}.ds-ev{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;margin-block-start:6px}.ds-ev-single{color:var(--ev-single,#7a6111)}"
    },
    {
      "name": "Party Slot",
      "kind": "custom",
      "refersTo": "party-slot",
      "description": "A picker slot. The party's colour field runs the slot's full height on its leading edge.",
      "html": "<div class=\"ds-slots\"><button class=\"ds-slot\" style=\"--c:#2a6fb0\"><span class=\"ds-fieldmark\"></span><span class=\"ds-tile\">RNI</span><span class=\"ds-who\"><span class=\"ds-abbr\">RNI</span><span class=\"ds-full\">National Rally of Independents</span></span></button><button class=\"ds-slot ds-empty\">+ Add a party</button></div>",
      "css": ".ds-slots{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-slot{display:flex;align-items:center;gap:11px;text-align:start;background:var(--page,#f2efe6);border:1px solid var(--rule,#d8d3c4);border-radius:10px;padding:11px 12px;min-height:68px;width:100%;color:var(--ink,#15181c);cursor:pointer;position:relative;overflow:hidden;font:inherit}.ds-slot:hover{border-color:var(--ink,#15181c)}.ds-slot:focus-visible{outline:2px solid var(--signal,#e8a13a);outline-offset:2px}.ds-fieldmark{position:absolute;inset-block:0;inset-inline-start:0;width:5px;background:var(--c)}.ds-tile{width:40px;height:40px;border-radius:7px;background:var(--c);color:#fff;font-weight:800;font-size:13px;display:grid;place-items:center;flex:none;margin-inline-start:4px}.ds-who{min-width:0}.ds-abbr{font-weight:800;font-size:16px;display:block}.ds-full{font-size:12.5px;color:var(--muted,#61646a);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-empty{border-style:dashed;color:var(--muted,#61646a);justify-content:center;font-weight:700}.ds-empty:hover{border-color:var(--signal,#e8a13a);color:var(--ink,#15181c)}"
    },
    {
      "name": "Form Guide",
      "kind": "custom",
      "refersTo": "form-mark",
      "description": "The last five general elections by finishing position. Reports what happened; encodes no merit.",
      "html": "<div class=\"ds-fg\" style=\"--c:#2a6fb0\"><span class=\"ds-m\" data-r=\"ran\">02</span><span class=\"ds-m\" data-r=\"ran\">07</span><span class=\"ds-m\" data-r=\"top3\">11</span><span class=\"ds-m\" data-r=\"top3\">16</span><span class=\"ds-m\" data-r=\"1\">21</span><span class=\"ds-mlabel\">last 5 elections</span></div>",
      "css": ".ds-fg{display:flex;gap:4px;align-items:center;flex-wrap:wrap;font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-m{width:26px;height:26px;border-radius:7px;display:grid;place-items:center;font-size:11.5px;font-weight:800;font-variant-numeric:tabular-nums;background:var(--sunken,#e7e3d6);color:var(--ink-2,#4a4f56);border:1px solid var(--rule,#d8d3c4)}.ds-m[data-r=\"1\"]{background:var(--c);color:#fff;border-color:transparent}.ds-m[data-r=\"top3\"]{background:color-mix(in oklab,var(--c) 26%,transparent);color:var(--ink,#15181c)}.ds-mlabel{font-size:11.5px;color:var(--muted,#61646a);margin-inline-start:4px}"
    },
    {
      "name": "Counter-Evidence Block",
      "kind": "custom",
      "refersTo": "counter-block",
      "description": "What qualifies or contradicts the claim above it, in the same cell rather than a footnote.",
      "html": "<div class=\"ds-counter\"><b>What this does not mean</b>Jobs announced in the 2026 programme; do not equate with HCP net employment.</div>",
      "css": ".ds-counter{padding:8px 10px;background:var(--sunken,#e7e3d6);border-radius:10px;font-size:13px;color:var(--ink-2,#4a4f56);font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-counter b{color:var(--ink,#15181c);font-weight:700;display:block;font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;margin-block-end:2px}"
    },
    {
      "name": "Evidence Tags",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Four states, each with its own glyph and words. Never colour alone. Rates the source, never the party.",
      "html": "<div class=\"ds-evs\"><span class=\"ds-ev\" style=\"--c:#1b7247\"><svg viewBox=\"0 0 20 20\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 10.5l3 3 6.5-7\"/><path d=\"M9 13.5l2 2 6.5-7\"/></svg>corroborated</span><span class=\"ds-ev\" style=\"--c:#7a6111\"><svg viewBox=\"0 0 20 20\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"10\" cy=\"10\" r=\"6.5\"/><circle cx=\"10\" cy=\"10\" r=\"1.6\" fill=\"currentColor\" stroke=\"none\"/></svg>single source</span><span class=\"ds-ev\" style=\"--c:#a14b1c\"><svg viewBox=\"0 0 20 20\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><circle cx=\"10\" cy=\"10\" r=\"6.5\"/><path d=\"M10 3.5v13\"/><path d=\"M10 10l5-4\"/></svg>disputed</span><span class=\"ds-ev\" style=\"--c:#61646a\"><svg viewBox=\"0 0 20 20\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><circle cx=\"10\" cy=\"10\" r=\"6.5\" stroke-dasharray=\"2.6 2.6\"/></svg>no evidence recorded</span></div>",
      "css": ".ds-evs{display:flex;flex-wrap:wrap;gap:14px;font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-ev{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:var(--c)}.ds-ev svg{flex:none}"
    },
    {
      "name": "Group Header",
      "kind": "custom",
      "refersTo": "group-header",
      "description": "A full-width ink band opening each comparison group.",
      "html": "<div class=\"ds-group\">Where they stand</div>",
      "css": ".ds-group{background:var(--ink,#15181c);color:var(--surface,#fbf9f3);padding:12px 14px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-family:var(--font,Tajawal,system-ui,sans-serif)}"
    },
    {
      "name": "Buttons",
      "kind": "button",
      "refersTo": "button",
      "description": "Pills. Signal Amber fills only when the reader has chosen this one.",
      "html": "<div class=\"ds-btns\"><button class=\"ds-btn ds-on\">Elections</button><button class=\"ds-btn\">Governments</button><button class=\"ds-btn\">Events</button></div>",
      "css": ".ds-btns{display:flex;gap:6px;flex-wrap:wrap;font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-btn{font:inherit;font-size:14px;font-weight:700;color:var(--ink-2,#4a4f56);background:var(--surface,#fbf9f3);border:1px solid var(--rule-strong,#b9b3a1);border-radius:999px;padding:7px 13px;cursor:pointer}.ds-btn:hover{color:var(--ink,#15181c);border-color:var(--ink,#15181c)}.ds-btn:focus-visible{outline:2px solid var(--signal,#e8a13a);outline-offset:2px}.ds-on{background:var(--signal,#e8a13a);border-color:var(--signal,#e8a13a);color:var(--ink,#15181c)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Pill links; the current page fills Ink. Wraps to its own row under 760px.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\"><svg viewBox=\"0 0 20 20\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M3 4h14M3 4v12M10 4v12M17 4v12M3 16h14M3 9h14M3 12.5h14\"/></svg>Ntikhabat</a><nav class=\"ds-nav\"><a class=\"ds-cur\">Compare</a><a>The record</a><a>How we know</a></nav></header>",
      "css": ".ds-top{display:flex;align-items:center;gap:14px;min-height:58px;padding:0 16px;background:var(--surface,#fbf9f3);border-block-end:2px solid var(--ink,#15181c);font-family:var(--font,Tajawal,system-ui,sans-serif)}.ds-brand{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:19px;letter-spacing:-.03em;color:var(--ink,#15181c);text-decoration:none;white-space:nowrap}.ds-nav{display:flex;gap:2px;flex:1}.ds-nav a{color:var(--ink-2,#4a4f56);padding:7px 11px;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none;cursor:pointer;white-space:nowrap}.ds-nav a:hover{background:var(--sunken,#e7e3d6);color:var(--ink,#15181c)}.ds-nav a.ds-cur{background:var(--ink,#15181c);color:var(--surface,#fbf9f3)}"
    },
    {
      "name": "Untranslated Marker",
      "kind": "custom",
      "refersTo": "chip",
      "description": "Prose with no translation in the reader's language states its source language rather than pretending.",
      "html": "<p class=\"ds-untr\"><span class=\"ds-src\">EN</span>Created after the June 1977 legislative elections, in which candidates running as independents won a majority of seats.</p>",
      "css": ".ds-untr{border-inline-start:1px solid var(--rule-strong,#b9b3a1);padding-inline-start:8px;font-size:14px;color:var(--ink-2,#4a4f56);font-family:var(--font,Tajawal,system-ui,sans-serif);margin:0}.ds-src{display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted,#61646a);background:var(--sunken,#e7e3d6);border-radius:4px;padding:1px 5px;margin-inline-end:6px;vertical-align:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Focus moves the border to Slate and keeps the amber ring; never removes the outline.",
      "html": "<input class=\"ds-field\" type=\"search\" placeholder=\"Search a party by name or initials\">",
      "css": ".ds-field{font-family:var(--font,Tajawal,system-ui,sans-serif);font-size:16px;color:var(--ink,#15181c);background:var(--surface,#fbf9f3);border:1px solid var(--rule-strong,#b9b3a1);border-radius:10px;padding:10px 12px;width:100%;caret-color:var(--slate,#33607e)}.ds-field::placeholder{color:var(--muted,#61646a)}.ds-field:focus-visible{outline:2px solid var(--signal,#e8a13a);outline-offset:1px;border-color:var(--slate,#33607e)}"
    }
  ],
  "narrative": {
    "northStar": "The Match-Day Table",
    "overview": "Ntikhabat is a comparison instrument. Its grammar is the one every Moroccan already\nreads fluently every week — the match-day page, with its ruled rows, its form guide,\nits heavy names and its tabular figures. A reader who has never seen this site before\nhas read this layout a thousand times, and that fluency is the whole point: a voter\nwith days to decide should not have to learn an interface first.\n\nIt borrows that page's **comparison** language and refuses its **ranking** language.\nThere is no standings position, no points column, no merit order, and no \"top party\".\nParties are ordered by the reader's own choice or alphabetically, never by performance.\nWinning an election is a fact and appears as one; being *better* is never encoded\nanywhere in this system. On a site bound to strict editorial neutrality, that refusal\nis not a detail — it is the reason the form was allowed in at all.\n\nThe ground is warm newsprint (`#f2efe6`) under ink (`#15181c`), with one interface\ncolour — a signal amber (`#e8a13a`) reserved exclusively for the reader's own choices —\nand a slate (`#33607e`) carrying structure and links. Light is not a preference here but\nthe use scene: the reader is on a cheap phone, outdoors, in Moroccan September sunlight.\nDark exists for night reading and inverts the same token set.\n\nType is **Tajawal**, carrying Arabic and Latin in one family. That is not a stylistic\nchoice but a structural one: a trilingual interface where Darija sits in a different\ntypeface from French is three designs pretending to be one. Self-hosted and subset to\n76KB for all six files.",
    "keyCharacteristics": [
      "Comparison grammar without ranking grammar — the central discipline of the system",
      "A party owns a full colour field down its whole column, never a dot",
      "One magnitude variable: the signed −2…+2 meter, identical everywhere a score appears",
      "Four visually distinct evidence states, judging the source and never the party",
      "Every claim carries its counter-evidence in the same field",
      "Absence is withheld and counted, never rendered as rows of empty cells",
      "Arabic set at display scale, not as metadata beneath French"
    ],
    "rules": [
      {
        "name": "The Not-Their-Colour Rule",
        "section": "colors",
        "body": "No party's real brand colour appears anywhere in this interface. A party rendered in its own livery reads as affiliation rather than as a series, and the eight-slot palette is validated as a set. The only place a party's own colours legitimately appear is inside a logo or portrait from data/media.json, which is content, not chrome."
      },
      {
        "name": "The Reader's Colour Rule",
        "section": "colors",
        "body": "Signal Amber marks only what the reader chose. It is never spent on emphasis, on a party, or on a value the data supplies."
      },
      {
        "name": "The Two-Systems Rule",
        "section": "colors",
        "body": "Party colour and evidence colour never mix. A party is never tinted by how well sourced it is, and evidence is never tinted by whose it is."
      },
      {
        "name": "The Aligned-Figure Rule",
        "section": "typography",
        "body": "Every value a reader might compare down a column is tabular."
      },
      {
        "name": "The Isolation Rule",
        "section": "typography",
        "body": "Numerals and mixed number-and-word phrases are wrapped in <bdi>, and negatives use U+2212. Without it, -1 renders as 1- under dir=rtl and \"27.7% of the vote\" reverses. Any new numeric string is isolated the same way."
      },
      {
        "name": "The Two-Rules Rule",
        "section": "elevation",
        "body": "A divider is either a 1px hairline or a 2px ink rule. The hairline separates peers; the ink rule separates sections. There is no third weight, and nothing casts a shadow."
      }
    ],
    "dos": [
      "Do show what happened, and let the reader decide what it means.",
      "Do give a party a full colour field down its column.",
      "Do use the meter for every signed score, unchanged.",
      "Do put counter-evidence in the same cell as the claim.",
      "Do withhold and count empty rows rather than rendering them.",
      "Do wrap numerals and mixed phrases in `<bdi>`, and use U+2212 for negatives.",
      "Do use logical properties for anything directional.",
      "Do title every chart axis.",
      "Do measure contrast against the real ground; light mode is the tight one."
    ],
    "donts": [
      "Don't rank parties, anywhere, by anything. No standings, no points, no \"top\".",
      "Don't give a party its real brand colour.",
      "Don't spend Signal Amber on anything the reader did not choose.",
      "Don't tint a party by evidence strength, or evidence by whose it is.",
      "Don't add a `box-shadow`, or a third divider weight.",
      "Don't introduce a second typeface; Arabic and Latin share one family by design.",
      "Don't use a physical `left`/`right` property.",
      "Don't convey a state by colour alone — every evidence state has a glyph and words.",
      "Don't present untranslated prose without its source-language marker."
    ]
  }
}
